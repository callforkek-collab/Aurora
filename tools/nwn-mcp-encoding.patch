 /** Read a text file (e.g., .nss source) */
+/** Windows-1251 upper half (0x80-0xFF) as Unicode, for Russian NWN text */
+const CP1251_HIGH =
+  "\u0402\u0403\u201A\u0453\u201E\u2026\u2020\u2021\u20AC\u2030\u0409\u2039\u040A\u040C\u040B\u040F" +
+  "\u0452\u2018\u2019\u201C\u201D\u2022\u2013\u2014\uFFFD\u2122\u0459\u203A\u045A\u045C\u045B\u045F" +
+  "\u00A0\u040E\u045E\u0408\u00A4\u0490\u00A6\u00A7\u0401\u00A9\u0404\u00AB\u00AC\u00AD\u00AE\u0407" +
+  "\u00B0\u00B1\u0406\u0456\u0491\u00B5\u00B6\u00B7\u0451\u2116\u0454\u00BB\u0458\u0405\u0455\u0457";
+
+function isCp1251(): boolean {
+  return /^(windows-?1251|cp-?1251)$/i.test(NWN_ENCODING);
+}
+
+/** Encode NWScript source for the compiler: string literals are copied byte for byte into .ncs */
+export function encodeNwnText(text: string): Buffer {
+  if (!isCp1251()) return Buffer.from(text, "utf-8");
+  const out = Buffer.alloc(text.length);
+  let n = 0;
+  for (const ch of text) {
+    const code = ch.codePointAt(0)!;
+    if (code < 0x80) out[n++] = code;
+    else if (code >= 0x0410 && code <= 0x044F) out[n++] = code - 0x0410 + 0xC0;
+    else {
+      const i = CP1251_HIGH.indexOf(ch);
+      out[n++] = i >= 0 ? 0x80 + i : 0x3F; // "?" for characters cp1251 cannot hold
+    }
+  }
+  return out.subarray(0, n);
+}
+
+export function decodeNwnText(buf: Buffer): string {
+  if (!isCp1251()) return buf.toString("utf-8");
+  let s = "";
+  for (const b of buf) {
+    if (b < 0x80) s += String.fromCharCode(b);
+    else if (b >= 0xC0) s += String.fromCharCode(b - 0xC0 + 0x0410);
+    else s += CP1251_HIGH[b - 0x80];
+  }
+  return s;
+}
+
+/** Write a .nss source in the configured NWN encoding */
+export async function writeNssFile(filePath: string, source: string): Promise<void> {
+  await fs.writeFile(filePath, encodeNwnText(source));
+}
+
 export async function readTextFile(filePath: string): Promise<string> {
+  if (/\.nss$/i.test(filePath)) return decodeNwnText(await fs.readFile(filePath));
   return fs.readFile(filePath, "utf-8");
 }
